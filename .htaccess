# Root .htaccess for Laravel on Shared Hosting
# This file redirects all requests to the public folder

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect to public folder (for standard Laravel structure)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Security: Deny access to sensitive files and directories
<FilesMatch "^(\.env|composer\.(json|lock)|package\.(json|lock)|\.git|\.gitignore|README\.md|DEPLOYMENT.*\.md|deploy-to-hostinger\.sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to directories
<IfModule mod_rewrite.c>
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]
</IfModule>

# CORS Headers (if needed)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
